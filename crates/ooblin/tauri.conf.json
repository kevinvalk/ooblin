{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ooblin",
  "identifier": "nl.kevinvalk.ooblin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:16420",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ooblin",
        "width": 1180,
        "height": 860,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:16420; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFQkY5MkZFM0ZFNDUyODUKUldTRlV1US8vcEsvYnE0NE53N2FsNkp1K2s2anVkUU9UcFdVSlp1SnV4V3p4Vk1jOS93d2pzRHMK",
      "endpoints": ["https://github.com/kevinvalk/ooblin/releases/latest/download/latest.json"]
    }
  }
}
